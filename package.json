{
  "name": "zkchat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html README.md docs/*.md",
    "check:public": "node scripts/check-public.mjs",
    "check:cors": "node scripts/check-cors.mjs",
    "check:browser": "ZKCHAT_LIVE_CHECK=1 playwright test tests/public.live.spec.ts --workers=1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-wallet": "0.21.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/ui-registry": "1.1.1",
    "@zkapi/solana-sdk": "file:vendor/zkapi-solana-sdk-0.2.0-devnet.3.tgz",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
