{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "zkchat static frontend on private S3 and CloudFront FREE flat-rate pricing. Deploy in us-east-1. Distribution stays disabled until FREE subscription is verified ACTIVE.",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": {
            "default": "Publish only after checking the FREE subscription"
          },
          "Parameters": [
            "DistributionEnabled"
          ]
        }
      ]
    },
    "DeploymentNotes": [
      "Use us-east-1 because the CloudFront-scope WAF web ACL lives there.",
      "The FREE subscription covers CloudFront and its associated WAF; S3 request charges are separate.",
      "WAF creation occurs before subscription activation and may have a small prorated charge.",
      "Eligibility, the three-FREE-plan account quota, and service support must be verified before deployment.",
      "The S3 bucket is retained on stack deletion or replacement; remove retained content explicitly when no longer needed.",
      "Set Cache-Control metadata during upload. HTML/config: public,max-age=0,s-maxage=60,must-revalidate; fingerprinted assets: public,max-age=31536000,immutable.",
      "The managed CachingOptimized policy ignores cookies and query strings and has a one-second minimum TTL.",
      "No custom error response rewrites: missing assets and configuration must not return HTML."
    ]
  },
  "Parameters": {
    "DistributionEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Leave false until the subscription is ACTIVE with CurrentPlanTier FREE and the site files are uploaded."
    }
  },
  "Conditions": {
    "EnableDistribution": {
      "Fn::Equals": [
        {
          "Ref": "DistributionEnabled"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "zkchat"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "SiteOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Join": [
              "-",
              [
                "zkchat",
                {
                  "Fn::Select": [
                    2,
                    {
                      "Fn::Split": [
                        "/",
                        {
                          "Ref": "AWS::StackId"
                        }
                      ]
                    }
                  ]
                },
                "s3"
              ]
            ]
          },
          "Description": "Read-only access to this zkchat static site bucket",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SiteRoutes": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Join": [
            "-",
            [
              "zkchat",
              {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Ref": "AWS::StackId"
                      }
                    ]
                  }
                ]
              },
              "routes"
            ]
          ]
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Route zkchat and recovery entry points; do not mask missing objects",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "// Keep FunctionCode in static-site.json identical to this file.\n// Rewrite only real entry points: missing assets/config must remain errors.\nfunction handler(event) {\n  var request = event.request;\n\n  if (request.uri === '/recovery-v3' || request.uri === '/recovery-v12') {\n    var query = [];\n    var parameters = request.querystring || {};\n    Object.keys(parameters).forEach(function (name) {\n      var parameter = parameters[name];\n      var values = parameter.multiValue || [parameter];\n      values.forEach(function (item) {\n        // CloudFront keeps query components URL-encoded in the event.\n        query.push(name + '=' + item.value);\n      });\n    });\n    return {\n      statusCode: 301,\n      statusDescription: 'Moved Permanently',\n      headers: {\n        location: {\n          value: request.uri + '/' + (query.length ? '?' + query.join('&') : '')\n        },\n        'cache-control': { value: 'public, max-age=300' }\n      }\n    };\n  }\n\n  if (request.uri === '/') {\n    request.uri = '/index.html';\n  } else if (request.uri === '/recovery-v3/' || request.uri === '/recovery-v12/') {\n    request.uri += 'index.html';\n  }\n\n  return request;\n}\n"
      }
    },
    "SiteWebAcl": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Description": "Dedicated Web ACL required by the CloudFront FREE flat-rate plan",
        "Scope": "CLOUDFRONT",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": false,
          "MetricName": "zkchatStaticSite"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "zkchat"
          }
        ]
      }
    },
    "SiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Comment": {
            "Fn::Sub": "zkchat static frontend - ${AWS::StackName}"
          },
          "Enabled": {
            "Fn::If": [
              "EnableDistribution",
              true,
              false
            ]
          },
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "WebACLId": {
            "Fn::GetAtt": [
              "SiteWebAcl",
              "Arn"
            ]
          },
          "Origins": [
            {
              "Id": "StaticSite",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "SiteOriginAccessControl"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "StaticSite",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SiteRoutes",
                    "FunctionMetadata.FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "zkchat"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowCloudFrontReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SiteBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${SiteBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "SiteSubscription": {
      "Type": "AWS::PricingPlanManager::Subscription",
      "Properties": {
        "PlanFamily": "CloudFront",
        "PlanTier": "FREE",
        "UsageLevel": "DEFAULT",
        "ResourceArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
          },
          {
            "Fn::GetAtt": [
              "SiteWebAcl",
              "Arn"
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Description": "Private upload bucket, retained on stack deletion",
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Description": "Dedicated frontend CloudFront distribution",
      "Value": {
        "Ref": "SiteDistribution"
      }
    },
    "DistributionArn": {
      "Value": {
        "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
      }
    },
    "DistributionEnabled": {
      "Value": {
        "Ref": "DistributionEnabled"
      }
    },
    "SiteUrl": {
      "Description": "Available after FREE plan validation, uploading assets, and enabling the distribution",
      "Value": {
        "Fn::Sub": "https://${SiteDistribution.DomainName}"
      }
    },
    "RecoveryUrl": {
      "Value": {
        "Fn::Sub": "https://${SiteDistribution.DomainName}/recovery-v3/"
      }
    },
    "SubscriptionArn": {
      "Value": {
        "Ref": "SiteSubscription"
      }
    },
    "SubscriptionStatus": {
      "Value": {
        "Fn::GetAtt": [
          "SiteSubscription",
          "Status"
        ]
      }
    },
    "SubscriptionCurrentPlanTier": {
      "Value": {
        "Fn::GetAtt": [
          "SiteSubscription",
          "CurrentPlanTier"
        ]
      }
    },
    "WebAclArn": {
      "Value": {
        "Fn::GetAtt": [
          "SiteWebAcl",
          "Arn"
        ]
      }
    }
  }
}
